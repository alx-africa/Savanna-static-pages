{
  "openapi": "3.0.3",
  "info": { "title": "ALX Accessible Auth API", "version": "1.0.0" },
  "paths": {
    "/api/v1/auth/register": {
      "post": {
        "summary": "Create an account",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegisterRequest" }
            }
          }
        },
        "responses": {
          "201": { "description": "Account created" },
          "400": { "description": "Invalid input" },
          "409": { "description": "Email already registered" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RegisterRequest": {
        "type": "object",
        "required": ["name", "email", "phone", "alternativeIdType", "idReference", "password"],
        "properties": {
          "name": { "type": "string", "maxLength": 120 },
          "email": { "type": "string", "format": "email", "maxLength": 254 },
          "phone": { "type": "string", "maxLength": 30 },
          "alternativeIdType": { "type": "string", "maxLength": 40 },
          "idReference": { "type": "string", "maxLength": 100 },
          "password": { "type": "string", "minLength": 8, "maxLength": 200, "format": "password" }
        }
      }
    }
  }
}
